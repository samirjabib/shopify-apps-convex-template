# Shopify API credentials — populated by `shopify app env pull` once the app
# is linked. `npm run setup` runs that step automatically; you should rarely
# need to edit these by hand.
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_APP_URL=

# OAuth scopes. Source of truth lives in `shopify.app.toml [access_scopes].scopes`.
# Leave empty here; `shopify app env pull` mirrors the toml value into .env.
# (Set manually only if you intentionally diverge — they MUST stay in sync.)
SCOPES=

# Optional: only set if you use a custom shop domain (e.g. shop.example.com).
# When unset, only `*.myshopify.com` hosts are accepted as valid shops.
# SHOP_CUSTOM_DOMAIN=

# Convex — filled by `npm run setup` (or `npm run convex:key`) for local backend.
# For cloud deployments, paste from https://dashboard.convex.dev → Settings → Deploy Keys.
CONVEX_URL=
VITE_CONVEX_URL=
CONVEX_DEPLOY_KEY=

# Billing — opt-in.
# `none` (default) = no billing UI, no charges, no Mantle SDK calls. App runs free for all users.
# `mantle` = enable the Mantle adapter (sign up free at https://heymantle.com — $0/mo under $5K MTR).
BILLING_PROVIDER=none
# MANTLE_APP_ID=
# MANTLE_API_KEY=
